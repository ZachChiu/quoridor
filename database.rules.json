{
  /*
    Firebase Realtime Database 安全規則 —— 線上跑的就是這一份。

    部署：Firebase Console → Realtime Database → 規則，整份貼上後按「發布」。
    或 npx firebase-tools deploy --only database --project <project id>。

    以線上原本那份為底（2026-09 由 Zach 提供），加上 feedback。
    改之前先想清楚「線上正在跑的是哪一版程式」：規則一發布就生效，
    程式要等下一次發版 —— 兩邊必須同時相容。

    ── 房間 ─────────────────────────────────────────────────────────
    - 建房：只能建不存在的房，而且房主（A）必須是自己
    - 座位：空位只能坐自己；已坐的位子只有本人能重寫（重整時程式不會重寫，
      但留著不擋）。每個座位的欄位都驗證，多的一律拒絕
    - 棋譜 wgf：**只有輪到的人**能寫。這可以做到，因為程式只有一個地方寫棋譜
      （PlayClient 的同步 effect），寫入的 currentPlayer 已經是 engine 跳過
      無事可做的玩家之後的下一位 —— 資料庫的 currentPlayer 不會落後。
      （先前的註解說「自動跳過不寫回，所以不能這樣限制」，那是舊程式的事。）
      **將來做回合倒數時要改這條**：逾時代打是別人替輪到的人寫。
    - currentPlayer / status / winners：任一在座玩家。winners 必須能由投降的人
      自己寫 —— 投降是唯一不能從棋譜推導的結束方式
    - 房間多出來的欄位一律拒絕（$other）。新增欄位要先改這裡

    ── 回饋 ─────────────────────────────────────────────────────────
    只能新增、沒有人讀得到（裡面可能有選填的聯絡方式）；我從 Console 讀，
    Console 不受規則限制。uid 必須是本人、每個欄位有上限、多的欄位拒絕 ——
    不然任何人都能用一段腳本塞進任意大小的資料、冒用別人的 uid。

    兩種來源：對局結束的回饋（mode = local / online / ai，必有評分與棋譜），
    與首頁右上角的「聯絡我們」（mode = contact，不綁某一局：沒有棋譜、評分選填，
    但一定要有留言）。
  */
  "rules": {
    ".read": false,
    ".write": false,
    "rooms": {
      "$roomId": {
        ".read": "auth != null",
        ".write": "auth != null && !data.exists() && newData.child('players/A/uid').val() === auth.uid",
        "id": { ".validate": "newData.isString()" },
        "playersNum": { ".validate": "newData.val() === 2 || newData.val() === 3" },
        "createdAt": { ".validate": "newData.isNumber()" },
        "players": {
          "A": {
            ".write": "auth != null && (!data.exists() ? newData.child('uid').val() === auth.uid : data.child('uid').val() === auth.uid)",
            "uid": { ".validate": "newData.isString() && newData.val().length > 0" },
            "displayName": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 40" },
            "joinedAt": { ".validate": "newData.isNumber()" },
            "$other": { ".validate": false }
          },
          "B": {
            ".write": "auth != null && (!data.exists() ? newData.child('uid').val() === auth.uid : data.child('uid').val() === auth.uid)",
            "uid": { ".validate": "newData.isString() && newData.val().length > 0" },
            "displayName": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 40" },
            "joinedAt": { ".validate": "newData.isNumber()" },
            "$other": { ".validate": false }
          },
          "C": {
            ".write": "auth != null && (!data.exists() ? newData.child('uid').val() === auth.uid : data.child('uid').val() === auth.uid)",
            "uid": { ".validate": "newData.isString() && newData.val().length > 0" },
            "displayName": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 40" },
            "joinedAt": { ".validate": "newData.isNumber()" },
            "$other": { ".validate": false }
          },
          "$other": { ".validate": false }
        },
        "wgf": {
          ".write": "auth != null && ((data.parent().child('currentPlayer').val() === 'A' && data.parent().child('players/A/uid').val() === auth.uid) || (data.parent().child('currentPlayer').val() === 'B' && data.parent().child('players/B/uid').val() === auth.uid) || (data.parent().child('currentPlayer').val() === 'C' && data.parent().child('players/C/uid').val() === auth.uid))",
          ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 20000"
        },
        "currentPlayer": {
          ".write": "auth != null && (data.parent().child('players/A/uid').val() === auth.uid || data.parent().child('players/B/uid').val() === auth.uid || data.parent().child('players/C/uid').val() === auth.uid)",
          ".validate": "newData.val() === 'A' || newData.val() === 'B' || newData.val() === 'C'"
        },
        "status": {
          ".write": "auth != null && (data.parent().child('players/A/uid').val() === auth.uid || data.parent().child('players/B/uid').val() === auth.uid || data.parent().child('players/C/uid').val() === auth.uid)",
          ".validate": "newData.val() === 'waiting' || newData.val() === 'opening' || newData.val() === 'playing' || newData.val() === 'finished'"
        },
        "winners": {
          ".write": "auth != null && (data.parent().child('players/A/uid').val() === auth.uid || data.parent().child('players/B/uid').val() === auth.uid || data.parent().child('players/C/uid').val() === auth.uid)",
          "$index": { ".validate": "newData.val() === 'A' || newData.val() === 'B' || newData.val() === 'C' || newData.val() === 'draw'" }
        },
        "$other": { ".validate": false }
      }
    },
    "feedback": {
      ".read": false,
      "$entryId": {
        ".write": "auth != null && !data.exists()",
        ".validate": "newData.hasChildren(['uid', 'createdAt', 'mode']) && (newData.child('mode').val() === 'contact' ? newData.hasChild('message') : newData.hasChildren(['rating', 'wgf']))",
        "uid": { ".validate": "newData.val() === auth.uid" },
        "createdAt": { ".validate": "newData.isNumber()" },
        "rating": { ".validate": "newData.val() === 1 || newData.val() === 2 || newData.val() === 3" },
        "message": { ".validate": "newData.isString() && newData.val().length <= 800" },
        "contact": { ".validate": "newData.isString() && newData.val().length <= 120" },
        "wgf": { ".validate": "newData.isString() && newData.val().length <= 20000" },
        "mode": { ".validate": "newData.val() === 'local' || newData.val() === 'online' || newData.val() === 'ai' || newData.val() === 'contact'" },
        "playersNum": { ".validate": "newData.val() === 2 || newData.val() === 3" },
        "result": { ".validate": "newData.isString() && newData.val().length <= 40" },
        "ended": { ".validate": "newData.val() === 'natural' || newData.val() === 'resign' || newData.val() === 'unfinished'" },
        "ua": { ".validate": "newData.isString() && newData.val().length <= 400" },
        "viewport": { ".validate": "newData.isString() && newData.val().length <= 40" },
        "locale": { ".validate": "newData.isString() && newData.val().length <= 35" },
        "$other": { ".validate": false }
      }
    }
  }
}
